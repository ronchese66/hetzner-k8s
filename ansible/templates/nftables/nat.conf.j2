
#!/usr/sbin/nft -f

flush ruleset

table inet nat_gateway_filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept

        ct state invalid drop
        ct state established,related accept

        iifname { "{{ nat_public_interface }}", "{{ nat_private_interface }}" } udp sport 67 udp dport 68 accept

        iifname "{{ nat_private_interface }}" ip saddr 10.0.1.5 tcp dport 22 ct state new accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state invalid drop

        iifname "{{ nat_private_interface }}" oifname "{{ nat_public_interface }}" ip saddr { 10.0.1.2, 10.0.1.3, 10.0.1.4 } ct state new tcp dport { 53, 80, 443 } accept

        iifname "{{ nat_private_interface }}" oifname "{{ nat_public_interface }}" ip saddr { 10.0.1.2, 10.0.1.3, 10.0.1.4 } ct state new udp dport 53 accept

        iifname "{{ nat_private_interface }}" oifname "{{ nat_public_interface }}" ip saddr { 10.0.1.2, 10.0.1.3, 10.0.1.4 } ct state established,related accept

        iifname "{{ nat_public_interface }}" oifname "{{ nat_private_interface }}" ip daddr { 10.0.1.2, 10.0.1.3, 10.0.1.4 } ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table ip nat_gateway_translation {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "{{ nat_public_interface }}" ip saddr { 10.0.1.2, 10.0.1.3, 10.0.1.4 } masquerade
    }
}
